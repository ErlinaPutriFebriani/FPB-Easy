# Salin file ini menjadi .env lalu isi dari Supabase: Project Settings -> API
# Jika dikosongkan, aplikasi berjalan dalam "mode lokal" memakai api/data/konten.json
# (cocok untuk mencoba tanpa Supabase; jawaban siswa tidak disimpan permanen).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Pembimbing AI (opsional). Buat kunci di https://aistudio.google.com -> Get API key.
# JANGAN commit kunci asli. Jika kosong, aplikasi memakai petunjuk statis.
GEMINI_API_KEY=
GEMINI_MODEL=
